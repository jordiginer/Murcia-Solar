---
const moments = [
  { time: 'Por la mañana', title: 'Empieza la producción.', text: 'Cuando la luz llega a los módulos, el inversor transforma su corriente en electricidad para el edificio. La orientación y las sombras influyen en la hora de arranque.' },
  { time: 'Al mediodía', title: 'Aprovecha las horas de sol.', text: 'Si tus paneles producen más de lo que estás usando, puedes programar la lavadora o la recarga del coche en esa franja. En una nave, el consumo de maquinaria puede coincidir con la producción.' },
  { time: 'Al anochecer', title: 'Cambia el origen de la energía.', text: 'Al caer el sol disminuye la producción. Si tienes batería, puedes aprovechar parte de la energía almacenada durante el día. La red cubre el consumo restante en una instalación conectada.' },
];
---
<section class="solar-day" aria-labelledby="day-title">
  <div class="wrap day-layout">
    <div><p class="kicker"><span></span> Guía de autoconsumo</p><h2 id="day-title">Un día con<br/>placas solares.</h2><p class="day-intro">Murcia cuenta con más de 2.800 horas de sol al año. La clave para aprovecharlas es saber cuándo coincide esa luz con tu consumo. Explora un día en una vivienda con placas.</p></div>
    <div class="day-demo">
      <div class="sky" aria-hidden="true" data-moment="0"><div class="orbit"></div><div class="day-sun"></div><div class="roof"></div></div>
      <div class="day-moments">
        {moments.map((moment,index) => <details class="moment" name="solar-day" open={index===0}><summary>{moment.time}</summary><div><h3>{moment.title}</h3><p>{moment.text}</p></div></details>)}
      </div>
    </div>
  </div>
</section>
<script>
  const sky = document.querySelector<HTMLElement>('.sky')!;
  document.querySelectorAll<HTMLDetailsElement>('.moment').forEach((moment, index) => {
    moment.addEventListener('toggle', () => {
      if (moment.open) sky.dataset.moment = String(index);
    });
  });
</script>
