---
interface Solution {
  name: string;
  need: string;
  title: string;
  text: string;
  points: string[];
  link: string;
}

const { services } = Astro.props as { services: Solution[] };
---
<section class="solutions wrap section-space" id="soluciones" aria-labelledby="soluciones-titulo">
  <div class="section-head" data-reveal>
    <div>
      <p class="kicker"><span></span> Soluciones</p>
      <h2 id="soluciones-titulo">¿Qué quieres<br />resolver?</h2>
    </div>
    <p>Elige por dónde empezar. Te contamos qué podemos instalar y qué revisamos para preparar tu presupuesto.</p>
  </div>
  <div class="solution-picker" data-reveal>
    <div class="solution-tabs" hidden aria-label="Elige qué quieres resolver">
      {services.map((service, index) => (
        <button id={`opcion-${index}`} type="button" aria-controls={`solucion-${index}`}>
          {service.need}
        </button>
      ))}
    </div>
    <div class="solution-panels">
      {services.map((service, index) => (
        <article class="solution-panel" id={`solucion-${index}`}>
          <div class="solution-story">
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </div>
          <div class="solution-detail">
            <ul>{service.points.map((point) => <li>{point}</li>)}</ul>
            <div class="solution-actions flex flex-wrap items-center">
              <a class="button dark" href="#contacto" data-service={service.name}>Consultar {service.name.toLowerCase()}</a>
              <a class="text-link" href={service.link}>Ver servicio</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>('.solution-tabs')!;
  const tabs = [...list.querySelectorAll<HTMLButtonElement>('button')];
  const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!);
  list.setAttribute('role', 'tablist');
  list.hidden = false;

  function activate(index: number, focus = false) {
    tabs.forEach((tab, position) => {
      const selected = position === index;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
      panels[position].hidden = !selected;
    });
    if (focus) tabs[index].focus();
  }

  tabs.forEach((tab, index) => {
    tab.setAttribute('role', 'tab');
    panels[index].setAttribute('role', 'tabpanel');
    panels[index].setAttribute('aria-labelledby', tab.id);
    panels[index].tabIndex = 0;
    tab.addEventListener('click', () => activate(index));
    tab.addEventListener('keydown', (event) => {
      const next = {
        ArrowLeft: (index - 1 + tabs.length) % tabs.length,
        ArrowRight: (index + 1) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      }[event.key];
      if (next === undefined) return;
      event.preventDefault();
      activate(next, true);
    });
  });
  activate(0);
</script>
