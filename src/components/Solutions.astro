---
interface Solution {
  name: string;
  need: string;
  title: string;
  text: string;
  points: string[];
  link: string;
}

const { services } = Astro.props as { services: Solution[] };
---
<section class="solutions wrap section-space" id="soluciones" aria-labelledby="soluciones-titulo">
  <div class="section-head">
    <div><p class="kicker"><span></span> Servicios</p><h2 id="soluciones-titulo">Instalaciones eléctricas y térmicas.</h2></div>
  </div>
  <div class="service-list">
    {services.map((service, index) => (
      <details class="service" name="solutions" open={index === 0}>
        <summary>{service.name}<span class="toggle" aria-hidden="true"></span></summary>
        <div class="service-body">
          <p>{service.text}</p>
          <div><ul>{service.points.map(point => <li>{point}</li>)}</ul>
          <div class="service-links"><a class="quiet" href="#contacto" data-service={service.name}>Solicitar presupuesto</a><a class="quiet" href={service.link}>Ver servicio</a></div></div>
        </div>
      </details>
    ))}
  </div>
</section>
