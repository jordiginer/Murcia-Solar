---
import navigation from '../data/navigation.json';
interface Entry { label: string; children: Entry[] }
interface Props { entries?: Entry[] }
const { entries = navigation } = Astro.props;
---
<ul class="directory">
  {entries.map(entry => <li>
    <button type="button" data-upcoming={entry.label} aria-haspopup="dialog">{entry.label}</button>
    {entry.children.length > 0 && <details><summary aria-label={`Más páginas de ${entry.label}`}>Subpáginas</summary><Astro.self entries={entry.children} /></details>}
  </li>)}
</ul>
