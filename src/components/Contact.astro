<div class="contact-form" id="formulario" data-reveal>
  <h3>Solicita presupuesto</h3>
  <form action="https://murciasolar.es/#wpcf7-f1240-p6-o1" method="post" aria-label="Formulario de contacto">
    <input type="hidden" name="_wpcf7" value="1240" />
    <input type="hidden" name="_wpcf7_version" value="6.2.4.1" />
    <input type="hidden" name="_wpcf7_locale" value="es_ES" />
