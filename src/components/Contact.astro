<div class="contact-form" id="formulario" data-reveal>
  <h3>Solicita presupuesto</h3>
  <form method="dialog" novalidate data-upcoming-form="Solicitud de presupuesto" aria-label="Formulario de contacto">
    <label>Tu nombre<input name="your-name" autocomplete="name" maxlength="400" required /></label>
    <label>Tu correo electrónico<input type="email" name="your-email" autocomplete="email" maxlength="400" required /></label>
    <label>¿Qué servicio necesitas?
      <select id="service-subject" name="your-subject" required>
        <option value="">Selecciona un servicio</option>
        <option>Placas solares</option>
        <option>Carga para coche eléctrico</option>
        <option>Electricidad</option>
        <option>Climatización</option>
        <option>Otro servicio</option>
      </select>
    </label>
    <label>Cuéntanos más<textarea name="your-message" rows="2" maxlength="2000"></textarea></label>
    <div class="consent">
      <input id="privacy-consent" type="checkbox" required />
      <div><label for="privacy-consent">He leído la política de privacidad.</label>
      <button type="button" data-upcoming="Política de privacidad" aria-haspopup="dialog">Ver política de privacidad</button></div>
    </div>
    <button class="btn gold" type="submit">Enviar solicitud ↗</button>
  </form>
</div>
