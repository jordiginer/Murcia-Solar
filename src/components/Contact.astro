---
const whatsapp = 'https://api.whatsapp.com/send?l=es&phone=34635570836';
---
<div class="contact-form" id="formulario">
  <a href={whatsapp}><h2>Mándanos un WhatsApp</h2></a>
  <form action="https://murciasolar.es/#wpcf7-f1240-p6-o1" method="post" aria-label="Formulario de contacto">
    <input type="hidden" name="_wpcf7" value="1240" />
    <input type="hidden" name="_wpcf7_version" value="6.2.4.1" />
    <input type="hidden" name="_wpcf7_locale" value="es_ES" />
    <input type="hidden" name="_wpcf7_unit_tag" value="wpcf7-f1240-p6-o1" />
    <input type="hidden" name="_wpcf7_container_post" value="6" />
    <input type="hidden" name="_wpcf7_posted_data_hash" value="" />
    <label>Tu nombre<input name="your-name" autocomplete="name" maxlength="400" required /></label>
    <label>Tu correo electrónico<input type="email" name="your-email" autocomplete="email" maxlength="400" required /></label>
    <label>Asunto<input name="your-subject" maxlength="400" required /></label>
    <label>Tu mensaje (opcional)<textarea name="your-message" rows="2" maxlength="2000"></textarea></label>
    <button class="btn gold" type="submit">Enviar</button>
  </form>
  <a class="form-phone" href="tel:635570836">LLAMANOS :635 570 836</a>
</div>
