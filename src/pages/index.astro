---
import Site from '../layouts/Site.astro';
import Contact from '../components/Contact.astro';
import Projects from '../components/Projects.astro';

const base = import.meta.env.BASE_URL + 'imagenes/';
const whatsapp = 'https://wa.me/34635570836';
const calculator = 'https://murciasolar.es/calculadora-ahorro-solar-murcia/';
const services = [
  { title: 'Placas solares', image: 'placas.jpg', alt: 'Paneles fotovoltaicos sobre tejas', detail: 'Genera tu propia electricidad. Estudiamos tu consumo, dimensionamos la instalación y gestionamos los trámites.' },
  { title: 'Carga para coche eléctrico', image: 'cargador.jpg', alt: 'Coche eléctrico conectado a un punto de recarga', detail: 'Instalamos puntos de recarga en viviendas, garajes comunitarios y empresas.' },
  { title: 'Electricidad', image: 'electricidad.jpg', alt: 'Electricista revisando un cuadro eléctrico', detail: 'Instalaciones, reparaciones y asistencia eléctrica en Murcia.' },
  { title: 'Climatización', image: 'climatizacion.jpg', alt: 'Equipo de climatización en una vivienda', detail: 'Instalación de equipos adaptados a tu espacio y a tus necesidades.' },
];
const steps = [
  ['Cuéntanos qué necesitas', 'Revisamos tu consumo y tu espacio.'],
  ['Recibe tu propuesta', 'Te explicamos el presupuesto y las opciones.'],
  ['Instalamos el equipo', 'Coordinamos el montaje y la puesta en marcha.'],
  ['Empieza a usarlo', 'Te orientamos sobre el funcionamiento.'],
];
---
<Site title="Murcia Solar | Placas solares e instalaciones en Murcia" description="Placas solares, cargadores eléctricos, climatización y electricista 24 h en la Región de Murcia.">
  <div class="scroll-progress" aria-hidden="true"></div>
  <div class="site-cursor" aria-hidden="true"><span></span></div>
  <header id="inicio" class="site-header">
    <div class="wrap site-nav">
      <a class="brand" href="#inicio"><img src={base + 'home/logo-cabecera.webp'} alt="Murcia Solar" /></a>
      <nav class="desktop-nav" aria-label="Principal">
        <a href="#soluciones">Servicios</a>
        <a href="#proceso">Cómo trabajamos</a>
        <a href="#contacto">Contacto</a>
        <a href={calculator}>Calculadora solar ↗</a>
        <a class="btn dark" href="#formulario">Pide presupuesto ↗</a>
      </nav>
      <a class="btn mobile-nav" href="#soluciones">Servicios ↓</a>
    </div>
  </header>
  <main id="contenido">
    <section class="hero">
      <div class="wrap editorial-cover">
        <div class="cover-title">
          <p class="eyebrow">Instaladores en la Región de Murcia</p>
          <h1>
            <span class="title-line"><span>El sol de Murcia,</span></span>
            <span class="title-line"><span>en tu tejado.</span></span>
          </h1>
        </div>
        <div class="cover-note">
          <p>Placas solares, cargadores eléctricos, climatización y electricista 24 h.</p>
          <a class="btn gold" href="#formulario">Pide tu estudio gratuito ↗</a>
          <a class="cover-phone" href="tel:+34635570836">635 570 836</a>
          <a class="cover-calculator" href={calculator}>Calculadora solar ↗</a>
        </div>
        <figure class="editorial-photo" data-parallax>
          <img src={base + 'panorama.webp'} alt="Paneles solares instalados sobre una cubierta en Murcia" fetchpriority="high" />
          <figcaption>Instalación solar en Murcia</figcaption>
        </figure>
      </div>
      <div class="editorial-credentials">
        <div class="wrap">
          <strong>Certificados Tesla Energy y V2C</strong>
          <a href="#cobertura">Más de 10 años en Murcia <span class="coverage-desktop">/ Más de 45 municipios atendidos</span><span class="coverage-mobile">Ver zona de cobertura</span> ↗</a>
        </div>
      </div>
    </section>

    <section class="wrap block" id="soluciones" aria-labelledby="services-title">
      <div data-reveal>
        <h2 id="services-title">¿En qué te podemos ayudar?</h2>
        <p class="section-intro">Para viviendas, comunidades y empresas de toda Murcia.</p>
      </div>
      <div class="service-grid">
        {services.map((service, index) => (
          <article class="service-card" data-reveal data-delay={index % 2 * 65}>
            <div class="service-media"><img src={base + 'servicios/' + service.image} alt={service.alt} loading="lazy" decoding="async" /></div>
            <div class="service-copy">
              <h3>{service.title}</h3>
              <p>{service.detail}</p>
              <a href="#formulario" data-service={service.title}>Consultar instalación ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <Projects />

    <section class="wrap block" id="proceso" aria-labelledby="steps-title">
      <h2 id="steps-title" data-reveal>Tu instalación en 4 pasos</h2>
      <ol class="steps" data-reveal>
        {steps.map(([title, detail], index) => (
          <li style={`--step-index: ${index}`}>
            <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{title}</h3><p>{detail}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="contact" id="contacto" aria-labelledby="contact-title">
      <div class="wrap block contact-layout">
        <div class="contact-copy" data-reveal>
          <h2 id="contact-title">Hablemos de<br />tu instalación.</h2>
          <p>Cuéntanos qué necesitas y te preparamos un presupuesto gratuito.</p>
          <a class="btn gold" href={whatsapp}>Escríbenos por WhatsApp ↗</a>
          <div class="contact-phone"><a href="tel:+34635570836">635 570 836</a><br />L–V 9–19 h · S 9–14 h</div>
        </div>
        <Contact />
      </div>
    </section>

    <aside class="accessory" aria-labelledby="accessory-title">
      <div class="wrap accessory-layout" data-reveal>
        <div>
          <h2 id="accessory-title">Detector de fugas V2C</h2>
          <p>Consulta la compatibilidad con tu cargador V2C Trydan.</p>
        </div>
        <div>
          <p class="price">70 € · IVA incluido</p>
          <a class="btn dark" href="https://murciasolar.es/detector-fugas-dc-v2c-trydan-md0630t01a/">Consultar compra ↗</a>
        </div>
      </div>
    </aside>
  </main>

  <footer class="footer">
    <div class="wrap footer-layout">
      <div>
        <a class="footer-brand" href="#inicio">Murcia Solar</a>
        <p>Energía solar, movilidad eléctrica y servicios eléctricos en la Región de Murcia.</p>
        <a href="https://www.google.com/maps/search/?api=1&query=C.+de+la+Manga+11+30005+Murcia">C. de la Manga, 11 · 30005 Murcia ↗</a>
      </div>
      <a class="footer-phone" href="tel:+34635570836">635 570 836 · Murcia</a>
      <small>© 2026 Murcia Solar Servicios Eléctricos SLU</small>
    </div>
  </footer>
</Site>

<script>
  import '../scripts/motion';

  const subject = document.querySelector<HTMLSelectElement>('#service-subject');
  document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach(link => {
    link.addEventListener('click', () => {
      if (subject) subject.value = link.dataset.service ?? '';
    });
  });
</script>
