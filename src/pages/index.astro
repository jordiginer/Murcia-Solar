---
import Site from '../layouts/Site.astro';
import Contact from '../components/Contact.astro';
import Projects from '../components/Projects.astro';
import PageDirectory from '../components/PageDirectory.astro';
import Upcoming from '../components/Upcoming.astro';
import home from '../data/home.json';

const base = import.meta.env.BASE_URL + 'imagenes/';
const services = [
  { title: 'Placas solares', image: 'placas.jpg', alt: 'Paneles fotovoltaicos sobre tejas', detail: 'Genera tu propia electricidad. Estudiamos tu consumo, dimensionamos la instalación y gestionamos los trámites.' },
  { title: 'Carga para coche eléctrico', image: 'cargador.jpg', alt: 'Coche eléctrico conectado a un punto de recarga', detail: 'Instalamos puntos de recarga en viviendas, garajes comunitarios y empresas.' },
  { title: 'Electricidad', image: 'electricidad.jpg', alt: 'Electricista revisando un cuadro eléctrico', detail: 'Instalaciones, reparaciones y asistencia eléctrica en Murcia.' },
  { title: 'Climatización', image: 'climatizacion.jpg', alt: 'Equipo de climatización en una vivienda', detail: 'Instalación de equipos adaptados a tu espacio y a tus necesidades.' },
];

---
<Site title="Murcia Solar | Placas solares e instalaciones en Murcia" description="Placas solares, cargadores eléctricos, climatización y electricista 24 h en la Región de Murcia.">
  <div class="scroll-progress" aria-hidden="true"></div>
  <div class="site-cursor" aria-hidden="true"><span></span></div>
  <header id="inicio" class="site-header">
    <div class="wrap site-nav">
      <a class="brand" href="#inicio"><img src={base + 'home/logo-cabecera.webp'} alt="Murcia Solar" /></a>
      <nav class="desktop-nav" aria-label="Principal">
        <a href="#soluciones">Servicios</a>
        <a href="#proceso">Cómo trabajamos</a>
        <a href="#contacto">Contacto</a>
        <button type="button" data-upcoming="Calculadora solar" aria-haspopup="dialog">Calculadora solar ↗</button>
        <a class="btn dark" href="#formulario">Pide presupuesto ↗</a>
      </nav>
      <a class="btn mobile-nav" href="#soluciones">Servicios ↓</a>
    </div>
  </header>
  <main id="contenido">
    <section class="hero">
      <div class="wrap editorial-cover">
        <div class="cover-title">
          <p class="eyebrow">Instaladores en la Región de Murcia</p>
          <h1>
            <span class="title-line"><span>El sol de Murcia,</span></span>
            <span class="title-line"><span>en tu tejado.</span></span>
          </h1>
        </div>
        <div class="cover-note">
          <p>Placas solares, cargadores eléctricos, climatización y electricista 24 h.</p>
          <a class="btn gold" href="#formulario">Pide tu estudio gratuito ↗</a>
          <button class="cover-phone" type="button" data-upcoming="Llamar a Murcia Solar" aria-haspopup="dialog">635 570 836</button>
          <button class="cover-calculator" type="button" data-upcoming="Calculadora solar" aria-haspopup="dialog">Calculadora solar ↗</button>
        </div>
        <figure class="editorial-photo" data-parallax>
          <img src={base + 'panorama.webp'} alt="Paneles solares instalados sobre una cubierta en Murcia" fetchpriority="high" />
          <figcaption>Instalación solar en Murcia</figcaption>
        </figure>
      </div>
      <div class="editorial-credentials">
        <div class="wrap">
          <strong>Certificados Tesla Energy y V2C</strong>
          <a href="#cobertura">Más de 10 años en Murcia <span class="coverage-desktop">/ Más de 45 municipios atendidos</span><span class="coverage-mobile">Ver zona de cobertura</span> ↗</a>
        </div>
      </div>
    </section>

    <section class="wrap block energy-needs" aria-labelledby="needs-title">
      <div data-reveal>
        <p class="eyebrow">Autoconsumo, movilidad y electricidad</p>
        <h2 id="needs-title">Tres necesidades, un equipo en Murcia</h2>
      </div>
      <div class="needs-grid">
        <article data-reveal><h3>Reduce tu factura</h3><p>Estudiamos tus consumos para dimensionar una instalación de autoconsumo que encaje con tu vivienda, comunidad o empresa.</p></article>
        <article data-reveal><h3>Recarga en casa</h3><p>Instalamos puntos de recarga certificados Tesla y V2C y los integramos con tu instalación fotovoltaica.</p></article>
        <article data-reveal><h3>Electricista de urgencia</h3><p>Atendemos averías, cortes de luz y problemas del cuadro eléctrico, también en festivos y fines de semana.</p></article>
      </div>
    </section>

    <section class="wrap block services-section" id="soluciones" aria-labelledby="services-title">
      <div data-reveal>
        <h2 id="services-title">¿En qué te podemos ayudar?</h2>
        <p class="section-intro">Para viviendas, comunidades y empresas de toda Murcia.</p>
      </div>
      <div class="service-grid">
        {services.map((service, index) => (
          <article class="service-card" data-reveal data-delay={index % 2 * 65}>
            <div class="service-media"><img src={base + 'servicios/' + service.image} alt={service.alt} loading="lazy" decoding="async" /></div>
            <div class="service-copy">
              <h3>{service.title}</h3>
              <p>{service.detail}</p>
              <ul class="service-points">
                {(home.services.items[index]?.points ?? ['Climatización para viviendas y empresas', 'Aire acondicionado y aerotermia', 'Asesoramiento e instalación a medida']).map(point => <li>{point}</li>)}
              </ul>
              <a href="#formulario" data-service={service.title}>Consultar instalación ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <Projects />

    <section class="trust-section" aria-labelledby="trust-title">
      <div class="wrap block trust-layout">
        <div data-reveal>
          <p class="eyebrow">Equipo y certificaciones</p>
          <h2 id="trust-title">{home.trust.title}</h2>
          <p>{home.trust.intro}</p>
        </div>
        <div>
          <dl class="trust-stats" data-reveal>
            {home.trust.items.slice(0, 3).map(item => <div><dt>{item.value}</dt><dd>{item.label}</dd></div>)}
          </dl>
          <div class="resource-links">
            <button type="button" data-upcoming="Certificación Tesla Energy" aria-haspopup="dialog">Tesla Energy ↗</button>
            <button type="button" data-upcoming="Certificación V2C" aria-haspopup="dialog">V2C Trydan ↗</button>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap block" id="proceso" aria-labelledby="steps-title">
      <h2 id="steps-title" data-reveal>Tu instalación en 4 pasos</h2>
      <ol class="steps" data-reveal>
        {home.process.items.map((step, index) => (
          <li style={`--step-index: ${index}`}>
            <span class="step-number" aria-hidden="true">{step.number}</span>
            <div><h3>{step.title}</h3><p>{step.body}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="press-section" aria-labelledby="press-title">
      <div class="wrap" data-reveal>
        <h2 id="press-title">Hablan de Murcia Solar</h2>
        <div class="press-media">
          <button type="button" data-upcoming="Murcia Solar en Avatar Energía" aria-haspopup="dialog">
            <img src={base + 'home/avatarenergia.webp'} alt="Avatar Energía" loading="lazy" />
          </button>
          <button type="button" data-upcoming="Murcia Solar en TikTok" aria-haspopup="dialog">
            <img src={base + 'home/tiktok.webp'} alt="TikTok de Murcia Solar" loading="lazy" />
          </button>
        </div>
      </div>
    </section>

    <section class="contact" id="contacto" aria-labelledby="contact-title">
      <div class="wrap block contact-layout">
        <div class="contact-copy" data-reveal>
          <h2 id="contact-title">Hablemos de<br />tu instalación.</h2>
          <p>Cuéntanos qué necesitas y te preparamos un presupuesto gratuito.</p>
          <button class="btn gold" type="button" data-upcoming="WhatsApp" aria-haspopup="dialog">Escríbenos por WhatsApp ↗</button>
          <div class="contact-phone"><button type="button" data-upcoming="Llamar a Murcia Solar" aria-haspopup="dialog">635 570 836</button><br />L–V 9–19 h · S 9–14 h</div>
        </div>
        <Contact />
      </div>
    </section>

    <aside class="accessory" aria-labelledby="accessory-title">
      <div class="wrap accessory-layout" data-reveal>
        <div>
          <h2 id="accessory-title">Detector de fugas V2C</h2>
          <p>Consulta la compatibilidad con tu cargador V2C Trydan.</p>
        </div>
        <div>
          <p class="price">70 € · IVA incluido</p>
          <button class="btn dark" type="button" data-upcoming="Compra del detector de fugas V2C" aria-haspopup="dialog">Consultar compra ↗</button>
        </div>
      </div>
    </aside>
  </main>

  <footer class="footer">
    <div class="wrap footer-layout">
      <div>
        <a class="footer-brand" href="#inicio">Murcia Solar</a>
        <p>Energía solar, movilidad eléctrica y servicios eléctricos en la Región de Murcia.</p>
        <button type="button" data-upcoming="Ubicación y mapa" aria-haspopup="dialog">C. de la Manga, 11 · 30005 Murcia ↗</button>
      </div>
      <button type="button" class="footer-phone" data-upcoming="Llamar a Murcia Solar" aria-haspopup="dialog">635 570 836 · Murcia</button>
      <details class="footer-directory">
        <summary>Explorar el sitio</summary>
        <PageDirectory />
      </details>
      <small>© 2026 Murcia Solar Servicios Eléctricos SLU</small>
    </div>
  </footer>
  <Upcoming />
</Site>

<script>
  import '../scripts/motion';

  const subject = document.querySelector<HTMLSelectElement>('#service-subject');
  document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach(link => {
    link.addEventListener('click', () => {
      if (subject) subject.value = link.dataset.service ?? '';
    });
  });
</script>
