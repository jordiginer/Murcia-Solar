---
import Site from '../layouts/Site.astro';
import Contact from '../components/Contact.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo = (name: string) => `${base}/imagenes/${name}.webp`;
const services = [
  { name: 'Placas solares', text: 'Autoconsumo para viviendas, comunidades y empresas. Valoramos si una batería encaja con tu consumo.', action: 'Pedir estudio solar' },
  { name: 'Cargadores eléctricos', text: 'Puntos de recarga Tesla Wall Connector y V2C. Podemos integrarlos con tus placas solares.', action: 'Consultar punto de carga' },
  { name: 'Aerotermia', text: 'Calefacción, refrigeración y agua caliente. Elegimos el equipo según las necesidades de tu vivienda.', action: 'Consultar aerotermia' },
  { name: 'Electricidad', text: 'Instalaciones, cambios de cuadro y boletines eléctricos. Servicio de urgencias 24 h.', action: 'Consultar instalación eléctrica' },
];
---

<Site title="Murcia Solar · Placas solares e instalaciones eléctricas" description="Autoconsumo, cargadores eléctricos, aerotermia e instalaciones eléctricas en la Región de Murcia. Solicita un estudio para tu vivienda o empresa.">
  <header class="header">
    <div class="wrap header-inner flex items-center justify-between gap-[18px]">
      <a href="#inicio" class="brand inline-flex items-center"><img src={photo('marca')} alt="Murcia Solar" width="83" height="45" /></a>
      <nav class="flex" aria-label="Principal">
        <a href="#servicios">Servicios</a>
        <a href="#trabajos">Instalaciones</a>
      </nav>
      <a class="button header-action" href="#contacto">Pedir presupuesto</a>
    </div>
  </header>
  <main id="contenido">
    <section class="hero wrap" id="inicio" aria-labelledby="principal">
      <div class="hero-top">
        <div>
          <p class="kicker">Instalación solar en la Región de Murcia</p>
          <h1 id="principal">Aquí el sol<br />da <em>corriente.</em></h1>
        </div>
        <div class="hero-summary">
          <p>Placas solares a medida para producir tu propia electricidad, en casa o en tu negocio.</p>
          <a class="button dark" href="#contacto" data-service="Placas solares">Pide un estudio solar</a>
        </div>
      </div>
      <figure class="hero-image relative">
        <img src={photo('cubierta')} alt="Vista de cerca de los paneles solares instalados por Murcia Solar en una cubierta de teja" width="1350" height="1013" fetchpriority="high" />
        <figcaption>Instalación residencial · Murcia Solar</figcaption>
      </figure>
      <div class="proof" aria-label="Experiencia y certificaciones">
        <div><strong>Más de 10 años</strong><span>de experiencia</span></div>
        <a href="https://murciasolar.es/instalador-certificado-tesla-energy/"><strong>Tesla Energy</strong><span>Instalador certificado</span></a>
        <a href="https://murciasolar.es/instalador-certificado-v2c/"><strong>V2C</strong><span>Instalador certificado</span></a>
      </div>
    </section>

    <section class="dark-section" id="servicios" aria-labelledby="servicios-titulo">
      <div class="wrap section-space service-layout">
        <div class="section-heading" data-reveal>
          <p class="kicker">Servicios</p>
          <h2 id="servicios-titulo">¿Qué necesitas instalar?</h2>
        </div>
        <ul class="services">
          {services.map(({ name, text, action }) => (
            <li>
              <h3>{name}</h3>
              <p>{text}</p>
              <a class="text-link" href="#contacto" data-service={name}>{action}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="wrap section-space work" id="trabajos" aria-labelledby="trabajos-titulo">
      <p class="kicker">Instalaciones de Murcia Solar</p>
      <h2 id="trabajos-titulo">De la azotea<br />a la nave.</h2>
      <div class="project-grid">
        <figure class="project-residential" data-reveal>
          <div class="photo-frame"><img src={photo('azotea')} width="1000" height="750" loading="lazy" alt="Paneles fotovoltaicos inclinados sobre una azotea" /></div>
          <figcaption>Autoconsumo residencial</figcaption>
        </figure>
        <figure class="project-industrial" data-reveal>
          <div class="photo-frame"><img src={photo('panorama')} width="1400" height="1050" loading="lazy" alt="Paneles solares sobre una cubierta industrial en Murcia" /></div>
          <figcaption>Instalación en cubierta industrial</figcaption>
        </figure>
      </div>
    </section>

    <section class="method" aria-labelledby="proceso">
      <div class="wrap section-space method-inner">
        <img src={photo('montaje')} width="850" height="825" loading="lazy" alt="Un técnico monta la estructura que sostiene los paneles fotovoltaicos" />
        <div data-reveal>
          <p class="kicker">Cómo trabajamos</p>
          <h2 id="proceso">Primero, medimos.</h2>
          <dl>
            <div><dt>Consumo y espacio</dt><dd>Revisamos cuánto consumes y dónde se puede instalar el equipo.</dd></div>
            <div><dt>Instalación y trámites</dt><dd>Montamos los equipos y gestionamos la legalización cuando corresponde.</dd></div>
            <div><dt>Seguimiento</dt><dd>Ofrecemos monitorización, mantenimiento y asistencia tras la instalación.</dd></div>
          </dl>
          <a class="text-link" href="https://murciasolar.es/testimonios-clientes-murcia-solar/">Leer las opiniones publicadas por Murcia Solar</a>
        </div>
      </div>
    </section>
    <Contact services={services} />
  </main>
  <footer class="wrap footer flex flex-wrap items-start justify-between">
    <a href="#inicio" class="brand inline-flex items-center"><img src={photo('marca')} alt="Murcia Solar" width="83" height="45" /></a>
    <address>Murcia Solar Servicios Eléctricos SLU<br />C. de la Manga, 11 · 30005 Murcia</address>
    <a class="text-link" href="https://murciasolar.es/politica-privacidad/">Privacidad</a>
  </footer>
</Site>
